# Copy to .env and fill in. NEVER commit .env.
BASE_URL=https://dummypay.vercel.app
# Two users registered manually once (no real e-mail needed, e.g. name@test.dummypay.dev)
USER1_EMAIL=
USER1_PASSWORD=
USER2_EMAIL=
USER2_PASSWORD=
# Public (anon) Supabase key - DevTools > Network > any request to supabase.co > header 'apikey'
DUMMYPAY_ANON_KEY=
